 /* FSBL may leave C906L executing a parked stub. Hold it before ELF load. */
+static ssize_t wake_store(struct device *dev, struct device_attribute *attr,
+                          const char *buf, size_t count)
+{
+    struct rproc *rproc = dev_get_drvdata(dev);
+    struct cvitek_rproc *ddata = rproc->priv;
+    bool send;
+    int ret;
+    (void)attr;
+    ret = kstrtobool(buf, &send);
+    if (ret) return ret;
+    if (mutex_lock_interruptible(&rproc->lock)) return -ERESTARTSYS;
+    if (rproc->state != RPROC_RUNNING ||
+        strcmp(rproc->firmware, "rvnano-freertos.elf") || !ddata->mbox_chan[MBOX_TX]) {
+        ret = -ENODEV;
+    } else if (send) {
+        ddata->wake_msg = 0x52565453;
+        ret = mbox_send_message(ddata->mbox_chan[MBOX_TX], &ddata->wake_msg);
+    } else {
+        /* rtos_ctl ACKs only after a firmware reply: channel was consumed. */
+        mbox_client_txdone(ddata->mbox_chan[MBOX_TX], 0);
+        ret = 0;
+    }
+    mutex_unlock(&rproc->lock);
+    return ret < 0 ? ret : count;
+}
+static DEVICE_ATTR_WO(wake);
